  "info": {
    "_postman_id": "dae47cd5-6920-4ea5-b3fa-232d0cfd0847",
    "name": "Adaption Adaptive Data Datasets Upload API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Adaptive Data API lets you ingest, adapt, evaluate, and export model-ready training datasets. Upload a dataset (direct file, HuggingFace, or Kaggle), configure column roles and augmentation recipes, run the adaptation pipeline, read the quality evaluation, download the adapted dataset, and publish it back to HuggingFace or Kaggle.\n\nContact Support:\n Name: Adaption Labs\n Email: info@adaptionlabs.ai",
      "type": "text/plain"
    }
  }
